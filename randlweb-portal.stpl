server {
    listen      %proxy_ssl_port% ssl;
    server_name %domain_idn% www.%domain_idn%;

    ssl_certificate      %ssl_pem%;
    ssl_certificate_key  %ssl_key%;
    ssl_stapling         on;
    ssl_stapling_verify  on;

    # Logs
    access_log  %home%/%user%/log/%domain%/nginx.access.log combined;
    error_log   %home%/%user%/log/%domain%/nginx.error.log;

    location / {
        proxy_pass         http://127.0.0.1:3336;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # Statische Assets direkt durch Nginx (Performance)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|woff|woff2|ttf|svg)$ {
        proxy_pass         http://127.0.0.1:3336;
        proxy_set_header   Host $host;
        expires            30d;
        add_header         Cache-Control "public, immutable";
    }
}
