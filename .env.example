NODE_ENV=production
PORT=3337
SESSION_SECRET=ersetze-mit-langem-zufaelligen-string-min-64-zeichen

# Authentik OIDC — Werte aus Authentik Admin UI holen
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://auth.randlweb.de/application/o/portal/
OIDC_REDIRECT_URI=https://randlweb.de/auth/callback

# MariaDB (Hestia radmin_ prefix beachten!)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=radmin_randl_portal
DB_USER=radmin_randl_portal_user
DB_PASS=

# App-URL (für Redirects)
APP_URL=https://randlweb.de
# gas-db (Postgres 127.0.0.1:5433). Ohne GAS_DB_USER meldet sich das Portal als gasadmin an (#232)
GAS_DB_USER=
GAS_DB_PASS=
